# Local development only. Never commit real credentials.
POSTGRES_DB=digital_invitation
POSTGRES_USER=digital_invitation
POSTGRES_PASSWORD=change-this-local-password
FRONTEND_PORT=8088
SPRING_PROFILES_ACTIVE=prod
APP_PUBLIC_BASE_URL=http://localhost:8088
APP_JWT_ISSUER=digital-invitation
APP_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
APP_JWT_ACCESS_TOKEN_MINUTES=15
APP_JWT_REFRESH_TOKEN_DAYS=30
APP_REFRESH_COOKIE_SECURE=false
APP_LOGIN_MAX_ATTEMPTS=8
APP_LOGIN_WINDOW_MINUTES=15
APP_LOGIN_BLOCK_MINUTES=15
APP_PUBLIC_RSVP_MAX_PER_HOUR=5
# Customer photo gallery/upload remains disabled until explicitly enabled.
APP_INVITATION_MEDIA_CUSTOMER_ENABLED=false

# Payment remains disabled until provider credentials and sandbox tests are configured.
APP_RAZORPAY_ENABLED=false
APP_RAZORPAY_KEY_ID=
APP_RAZORPAY_KEY_SECRET=
APP_RAZORPAY_WEBHOOK_SECRET=

# FileServer Master Drive. Use the FileServer branch that exposes /master-drive APIs.
APP_FILESERVER_ENABLED=false
APP_FILESERVER_BASE_URL=
APP_FILESERVER_MASTER_KEY=
# Set an ID if known; otherwise the adapter resolves this exact root drive name.
APP_FILESERVER_MASTER_DRIVE_ID=
APP_FILESERVER_MASTER_DRIVE_NAME=DigitalInvitation
APP_FILESERVER_UPLOAD_PATH=/master-drive/{driveId}/files/upload
APP_FILESERVER_STATUS_PATH=/master-drive/uploads/{uploadId}/status
APP_FILESERVER_DOWNLOAD_PATH=/master-drive/files/{fileId}/download
APP_FILESERVER_DELETE_PATH=/master-drive/files/{fileId}
APP_FILESERVER_UPLOAD_TIMEOUT_SECONDS=300
APP_FILESERVER_POLL_INTERVAL_MILLIS=1000

# Template package publishing. Use a fine-grained GitHub token with Contents read/write.
APP_GITHUB_TOKEN=
APP_GITHUB_REPOSITORY=laksheyjasoria/DigitalInvitation
APP_GITHUB_TEMPLATE_RELEASES_ENABLED=false
APP_GITHUB_TEMPLATE_RELEASE_BRANCH=template-releases
APP_GITHUB_TEMPLATE_BASE_BRANCH=feature/platform-implementation

APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ADMIN_PASSWORD=
APP_MAIL_ENABLED=false
APP_MAIL_FROM=no-reply@your-domain.example
SMTP_HOST=smtp.your-provider.example
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
APP_MAIL_OUTBOX_DELAY_MS=15000
