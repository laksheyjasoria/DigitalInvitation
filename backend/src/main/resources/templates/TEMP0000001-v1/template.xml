<?xml version="1.0" encoding="UTF-8"?>
<template id="TEMP0000001" displayName="Floral Garden" category="WEDDING"
 description="A romantic botanical wedding invitation with a dedicated animated page."
 version="1.0.0" layout="floral">
  <fields>
    <field key="headline" label="Invitation heading" type="text" required="true" removable="false" placeholder="Together with our families"/>
    <field key="hostNames" label="Names" type="text" required="true" removable="false" placeholder="Names of the hosts or couple"/>
    <field key="intro" label="Invitation message" type="textarea" removable="true"/>
    <field key="eventName" label="Function name" type="text" required="true" removable="false"/>
    <field key="date" label="Date" type="date" required="true" removable="false"/>
    <field key="time" label="Time" type="time" removable="true"/>
    <field key="venue" label="Venue" type="address" required="true" removable="false"/>
    <field key="description" label="Function details" type="textarea" removable="true"/>
    <field key="familyNames" label="Family names" type="text" removable="true"/>
    <field key="note" label="Closing note" type="textarea" removable="true"/>
    <field key="contact" label="Contact number" type="phone" removable="true"/>
  </fields>
  <sections>
    <section key="hero" label="The invitation" required="true" enabled="true">
      <field ref="headline"/><field ref="hostNames"/><field ref="intro"/>
    </section>
    <section key="events" label="Wedding celebrations" required="false" enabled="true" repeatable="true">
      <field ref="eventName"/><field ref="date"/><field ref="time"/><field ref="venue"/><field ref="description"/>
    </section>
    <section key="family" label="With blessings from" required="false" enabled="false">
      <field ref="familyNames"/>
    </section>
    <section key="footer" label="A note for our guests" required="false" enabled="true">
      <field ref="note"/><field ref="contact"/>
    </section>
  </sections>
</template>